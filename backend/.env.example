PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sih_patient_dashboard
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# OCR: images are transcribed via a vision model — Groq (reusing
# GROQ_API_KEY/GROQ_CHAT_MODEL below) when set, since qwen/qwen3.8-27b is
# also vision-capable with Strict Mode JSON; otherwise a local Ollama vision
# model. medgemma:4b is a medical-domain-tuned vision model and the
# recommended local default.
# Requires Ollama running locally with the model pulled: `ollama pull medgemma:4b`
# (llama3.2-vision also works if your Ollama build supports the "mllama" architecture.)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=medgemma:4b
OLLAMA_TIMEOUT_MS=120000

# Conversational intake chatbot: fills the visit's history fields live as the
# patient chats.
#
# Two backends, chosen automatically at runtime by whether GROQ_API_KEY is
# set — see ollamaChat.js's header comment for the full story:
#
# 1. Groq (cloud) — set GROQ_API_KEY (free key at console.groq.com) and this
#    takes priority. Faster and far more latency-consistent than local
#    inference on a VRAM-constrained machine; qwen/qwen3.8-27b also gets
#    Groq's Strict Mode structured outputs (schema-guaranteed valid JSON).
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# Free tier is rate-limited (measured: 7000 input tokens/min for this
# model, ~4 req/min for this app's ~1750-token system prompt) — this is an
# account-wide ceiling, not per-patient, so concurrent conversations can
# hit it under normal use, not just abuse. ollamaChat.js self-paces every
# outbound Groq call at least this many ms apart to stay under it.
# GROQ_MIN_INTERVAL_MS=16000
#
# 2. Local Ollama (default when GROQ_API_KEY is empty) — requires the model
#    pulled: `ollama pull qwen2.5:14b`
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_CHAT_NUM_CTX=8192
OLLAMA_CHAT_KEEP_ALIVE=30m
OLLAMA_CHAT_TIMEOUT_MS=120000

# RAG guardrail for the chatbot (grounds its follow-up questions in a small
# curated clinical-guideline set — see src/utils/chat/guidelines.json).
# Requires: `ollama pull nomic-embed-text`
OLLAMA_EMBED_MODEL=nomic-embed-text

# Voice input for the chat's mic button — proxied to the separate Python
# service in voice-service/ (faster-whisper). See voice-service/README.md.
VOICE_SERVICE_URL=http://localhost:8010
VOICE_TIMEOUT_MS=30000

# Translation for non-English chat visits — keeps the chat LLM working
# entirely in English while the patient converses in their own language.
# Proxied to the separate Python service in translate-service/ (NLLB-200).
# See translate-service/README.md.
TRANSLATE_SERVICE_URL=http://localhost:8020
# translate-service's own /translate call can internally wait up to 120s on
# transliterate-service's cold start (romanized input) before it even starts
# translating — this timeout wraps that WHOLE chain, so it must stay above
# that, not just above IndicTrans2's own translation time.
TRANSLATE_TIMEOUT_MS=140000
