node_modules/
.env
uploads/*
!uploads/.gitkeep
.mongo-data/
*.log

# Generated by scripts/ingestRagCorpus.js + embedRagCorpus.js — large,
# derived from source documents that live outside this repo, and the
# embeddings are tied to whatever OLLAMA_EMBED_MODEL produced them.
src/utils/chat/ragCorpus/*.json

# Raw reference documents (PDFs/docx/txt/md) fed into ingestRagCorpus.js —
# same reasoning as uploads/ above: large source material, not code.
rag-sources/*
!rag-sources/.gitkeep
