# Required: a Hugging Face access token whose account has clicked "Agree
# and access repository" on BOTH gated model pages below. A token alone is
# not enough without that click. Generate a read-only token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Override the default IndicTrans2 checkpoints if needed. Defaults work
# with zero configuration beyond HF_TOKEN above.
INDICTRANS_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M

# Where transliterate-service (romanized-input handling) is running.
# Optional — if unreachable, romanized input is translated as-is rather
# than failing (same graceful degradation as everything else here).
TRANSLITERATE_SERVICE_URL=http://localhost:8030
# Generous on purpose — that service's first request after startup loads
# its model + dictionaries (~60-90s); every request after that is fast.
TRANSLITERATE_TIMEOUT_S=120
